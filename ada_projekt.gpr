project Ada_Projekt is
   for Source_Dirs use ("src/**");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnat2022", "-gnatwa");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lSystem");
   end Linker;
end Ada_Projekt;
